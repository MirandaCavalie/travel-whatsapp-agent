# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox por defecto. En produccion, reemplazar por tu numero registrado.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# development | production
# En production se valida la firma de Twilio en cada request.
ENVIRONMENT=development

# URL publica del servidor (ngrok en dev, dominio real en prod).
# Solo necesaria si ENVIRONMENT=production para validar la firma de Twilio.
PUBLIC_BASE_URL=
